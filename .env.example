# ─── Supabase ───────────────────────────────────────────────────────────────
# Public: safe to expose in browser. Safe ONLY because RLS is enabled on every table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY. Bypasses RLS entirely. NEVER reference in any file imported by client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Cloudinary ─────────────────────────────────────────────────────────────
# Public: used by the Cloudinary upload widget in the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# SERVER-ONLY. Never expose to the browser.
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Resend ─────────────────────────────────────────────────────────────────
# SERVER-ONLY. Used for collaborator invites and account notifications.
RESEND_API_KEY=your-resend-api-key

# ─── Sentry ─────────────────────────────────────────────────────────────────
# Public: Sentry DSN is designed to be publicly exposed.
# Required for both the client-side React error boundary and server-side Route Handler wrapper.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/000000
